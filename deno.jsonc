{
  "name": "@ymjacky/mqtt5",
  "version": "0.2.2",
  "exports": {
    ".": "./deno/mod.ts",
    "./browser": "./browser/mod.ts"
  },
  "imports": {
    // Lets the examples import the package the same way users do after `deno add jsr:@ymjacky/mqtt5`.
    "@ymjacky/mqtt5": "./deno/mod.ts",
    "@ymjacky/mqtt5/browser": "./browser/mod.ts",
    // Used by the tests and browser/server.ts only; the library itself has no dependencies.
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/http": "jsr:@std/http@^1.1.4"
  },
  "publish": {
    "include": ["deno/", "browser/mod.ts", "lib/", "readme.md", "LICENSE"]
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 160,
    "include": [
      "browser",
      "deno",
      "lib",
      "examples",
      "test"
    ]
  },
  "lint": {
    "include": ["browser", "deno", "lib", "test", "examples"],

    "rules": {
      "tags": ["recommended"]
    },

    "report": "pretty"
  },
  "test": {
    "include": ["test/deno"]
  },
  "tasks": {
    "test": "deno test --unstable-kv --allow-net --allow-read --allow-write --trace-leaks test/deno/",
    "tsc": "deno check --doc deno/mod.ts browser/mod.ts lib/ && deno check --doc-only readme.md",
    "check": "deno lint && deno task tsc && deno task test",
    "build_esm": "deno bundle --platform browser -o browser/mqtt5.mjs browser/mod.ts"
  }
}

{
  "name": "@ymjacky/mqtt5",
  "version": "0.0.26",
  "exports": {
    ".": "./deno/mod.ts",
    "./browser": "./browser/mod.ts"
  },
  "imports": {
    // Lets the examples import the package the same way users do after `deno add jsr:@ymjacky/mqtt5`.
    "@ymjacky/mqtt5": "./deno/mod.ts",
    "@ymjacky/mqtt5/browser": "./browser/mod.ts",
    "std/": "https://deno.land/std@0.219.0/"
  },
  "publish": {
    "include": ["deno/", "browser/mod.ts", "lib/", "readme.md", "LICENSE"]
  },
  "fmt": {
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 160,
    "include": [
      "browser",
      "client",
      "deno",
      "lib",
      "examples",
      "test"
    ]
  },
  "lint": {
    "include": ["deno", "lib", "test", "examples"],
    "exclude": ["./exclude/"],

    "rules": {
      "tags": ["recommended"],
      "exclude": ["ban-untagged-todo"]
    },

    "report": "pretty"
  },
  "test": {
    "include": ["test/deno"]
  },
  "tasks": {
    "test": "deno test --allow-net --allow-read --trace-leaks test/deno/",
    "tsc": "deno check --doc deno/mod.ts browser/mod.ts lib/ && deno check --doc-only readme.md",
    "check": "deno lint && deno task tsc && deno task test",
    "build_ems": "deno bundle --platform browser -o browser/mqtt5.mjs browser/mod.ts"
  }
}
